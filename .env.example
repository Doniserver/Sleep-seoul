# 이 파일을 복사해 .env를 만들고 값을 채우세요. .env는 커밋하지 않습니다.

# 서울 열린데이터광장 일반 인증키 (data.seoul.go.kr)
SEOUL_OPENAPI_KEY=

# 공공데이터포털 일반 인증키 — Decoding 키 (data.go.kr, 건축물대장)
DATA_GO_KR_KEY=

# 동네 리포트 문장 생성용 Claude API 키 (platform.claude.com, Phase 5)
ANTHROPIC_API_KEY=

# 브이월드 인증키 (vworld.kr, 3D 지도·배경지도·검색). 브라우저에 노출되는 키라 등록한 주소에서만 동작
VITE_VWORLD_KEY=
